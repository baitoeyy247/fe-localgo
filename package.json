{
  "name": "localgo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/absolutize-assets.mjs",
    "build:sit": "ng build --configuration sit && node scripts/absolutize-assets.mjs",
    "build:cloudflare": "node scripts/generate-fe-environment.mjs && ng build --configuration sit && node scripts/absolutize-assets.mjs",
    "postbuild:assets": "node scripts/absolutize-assets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test e2e/skeleton-layout.spec.ts",
    "test:e2e:local": "E2E_SERVE=1 E2E_BASE_URL=http://127.0.0.1:4173 npm run build:sit && E2E_SERVE=1 playwright test e2e/skeleton-layout.spec.ts",
    "check:glossary": "node scripts/glossary-grep.mjs",
    "deploy:sit": "./scripts/deploy-pages.sh"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@line/liff": "^2.29.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.64.1",
    "@vitest/browser-playwright": "^4.1.7",
    "serve": "^14.2.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
